<section class="cart-page">
  <h1>Votre panier</h1>

  {% if cart.item_count == 0 %}
    <p>Votre panier est vide.</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn">Continuer mes achats</a>
  {% else %}
    {% form 'cart', cart %}
      <div class="cart-items">
        {% for item in cart.items %}
          <div class="cart-item">
            <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" loading="lazy">
            <div>
              <h3>{{ item.product.title }}</h3>
              {% unless item.product.has_only_default_variant %}
                <p class="tagline">{{ item.variant.title }}</p>
              {% endunless %}
              <div class="cart-qty-row">
                <label class="visually-hidden" for="qty-{{ item.key }}">Quantité</label>
                <input id="qty-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="cart-qty-input">
              </div>
            </div>
            <div class="cart-item-price">
              {% if item.original_line_price > item.final_line_price %}
                <span class="price-old">{{ item.original_line_price | money }}</span>
              {% endif %}
              <span class="price">{{ item.final_line_price | money }}</span>
            </div>
          </div>
        {% endfor %}
      </div>

      {% if cart.total_price >= 4000 %}
        <div class="cart-shipping-notice cart-shipping-notice--free">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="16" height="16" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-4"/><path d="M12 19v2"/><path d="M8 19v2"/></svg>
          Livraison offerte incluse
        </div>
      {% else %}
        {% assign remaining = 4000 | minus: cart.total_price %}
        <div class="cart-shipping-notice">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="16" height="16" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-4"/><path d="M12 19v2"/><path d="M8 19v2"/></svg>
          Plus que <strong>{{ remaining | money }}</strong> pour la livraison offerte
        </div>
      {% endif %}

      <div class="cart-total">
        <span>Total</span>
        <span class="price">{{ cart.total_price | money }}</span>
      </div>

      <div class="cart-checkout-block">
        <button type="submit" name="checkout" class="btn btn--checkout">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="18" height="18" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          Passer commande
        </button>
        <button type="submit" name="update" class="btn btn--ghost cart-update-btn">Mettre à jour le panier</button>
      </div>
    {% endform %}

    {% assign upsell_handle = section.settings.upsell_collection | default: 'all' %}
    {% assign upsell_col = collections[upsell_handle] %}
    {% if upsell_col.products.size > 0 %}
      {% assign cart_ids = cart.items | map: 'product_id' %}
      {% assign upsell_count = 0 %}
      {% for prod in upsell_col.products %}
        {% unless cart_ids contains prod.id %}
          {% if upsell_count == 0 %}
            <div class="cart-upsell">
              <p class="cart-upsell-title">Souvent achetés ensemble</p>
              <div class="cart-upsell-grid">
          {% endif %}
          {% if upsell_count < 2 %}
            <div class="cart-upsell-card">
              {% if prod.featured_image %}
                <img src="{{ prod.featured_image | image_url: width: 120 }}" alt="{{ prod.title | escape }}" loading="lazy" class="cart-upsell-img">
              {% endif %}
              <div class="cart-upsell-info">
                <strong>{{ prod.title }}</strong>
                <span>{{ prod.price | money }}</span>
              </div>
              <a href="{{ prod.url }}" class="btn cart-upsell-btn">Voir</a>
            </div>
            {% assign upsell_count = upsell_count | plus: 1 %}
          {% endif %}
        {% endunless %}
      {% endfor %}
      {% if upsell_count > 0 %}
              </div>
            </div>
      {% endif %}
    {% endif %}

    <div class="cart-reassurance">
      <div class="cart-reassurance-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg>
        <div>
          <strong>45 jours pour changer d'avis</strong>
          <span>Retour gratuit, remboursement complet. Sans justification.</span>
        </div>
      </div>
      <div class="cart-reassurance-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <div>
          <strong>Paiement 100% sécurisé</strong>
          <span>CB, PayPal, Apple Pay — données chiffrées.</span>
        </div>
      </div>
      <div class="cart-reassurance-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-4"/><path d="M12 19v2"/><path d="M8 19v2"/></svg>
        <div>
          <strong>Livraison 48h depuis la France</strong>
          <span>Expédié aujourd'hui si commande avant 16h.</span>
        </div>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Panier",
  "settings": [
    { "type": "collection", "id": "upsell_collection", "label": "Collection upsell (\"Souvent achetés ensemble\")" }
  ]
}
{% endschema %}
