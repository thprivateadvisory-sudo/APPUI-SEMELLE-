<section class="hero">
  {% if section.settings.eyebrow != blank %}
    <p class="eyebrow-free">{{ section.settings.eyebrow }}</p>
  {% endif %}
  <h1>{{ section.settings.heading }}</h1>
  {% if section.settings.text != blank %}
    <p class="lede">{{ section.settings.text }}</p>
  {% endif %}
  {% if section.settings.button_label != blank %}
    <a href="{{ section.settings.button_link }}" class="btn">{{ section.settings.button_label }}</a>
  {% endif %}

  <div class="hero-visual">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 640 }}" alt="{{ section.settings.heading | escape }}" loading="eager" width="320" height="260">
    {% else %}
      <svg viewBox="0 0 320 260" xmlns="http://www.w3.org/2000/svg">
        <path d="M120 12 C170 8 210 30 222 78 C232 118 250 140 250 176 C250 218 210 248 158 248 C104 248 66 224 60 180 C55 146 78 130 84 96 C90 62 82 16 120 12 Z" fill="#B85C34"/>
        <path d="M126 30 C168 27 200 46 210 84 C218 116 234 136 234 168 C234 202 200 226 156 226 C112 226 82 206 77 170 C73 142 92 128 97 100 C102 72 96 33 126 30 Z" fill="#E4D6BE"/>
        <path d="M150 46 C150 90 138 118 144 156 C149 188 172 200 172 200" stroke="#B85C34" stroke-width="3" fill="none" stroke-linecap="round" opacity="0.55"/>
        <ellipse cx="150" cy="70" rx="16" ry="20" fill="#B85C34" opacity="0.25"/>
      </svg>
    {% endif %}
  </div>

  {% if section.settings.stat_1_value != blank %}
    <div class="hero-stats">
      <div><b>{{ section.settings.stat_1_value }}</b>{{ section.settings.stat_1_label }}</div>
      <div><b>{{ section.settings.stat_2_value }}</b>{{ section.settings.stat_2_label }}</div>
      <div><b>{{ section.settings.stat_3_value }}</b>{{ section.settings.stat_3_label }}</div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texte au-dessus du titre", "default": "Semelles pensées pour vos pieds" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Vos pieds portent tout le poids. Il est temps de les soutenir." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Des semelles de confort et de posture, glissées dans vos chaussures en dix secondes." },
    { "type": "text", "id": "button_label", "label": "Bouton, texte", "default": "Découvrir les semelles" },
    { "type": "url", "id": "button_link", "label": "Bouton, lien" },
    { "type": "image_picker", "id": "image", "label": "Image (optionnel, remplace l'illustration)" },
    { "type": "text", "id": "stat_1_value", "label": "Statistique 1, valeur", "default": "4.8/5" },
    { "type": "text", "id": "stat_1_label", "label": "Statistique 1, libellé", "default": "2 300 avis" },
    { "type": "text", "id": "stat_2_value", "label": "Statistique 2, valeur", "default": "48h" },
    { "type": "text", "id": "stat_2_label", "label": "Statistique 2, libellé", "default": "Livraison" },
    { "type": "text", "id": "stat_3_value", "label": "Statistique 3, valeur", "default": "45j" },
    { "type": "text", "id": "stat_3_label", "label": "Statistique 3, libellé", "default": "Essai chez vous" }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
