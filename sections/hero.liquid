<section class="hero">
  <div class="hero-bg {% unless section.settings.image %}hero-bg--gradient{% endunless %}">
    {% if section.settings.image %}
      <img
        src="{{ section.settings.image | image_url: width: 1600 }}"
        alt=""
        role="presentation"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
  </div>

  <div class="hero-content">
    {% if section.settings.rating_text != blank %}
      <div class="hero-rating">
        <span class="stars-inline">★★★★★</span>
        {{ section.settings.rating_text }}
      </div>
    {% endif %}

    <h1>{{ section.settings.heading }}</h1>

    {% if section.settings.text != blank %}
      <p class="lede">{{ section.settings.text }}</p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="btn btn--hero">
        {{ section.settings.button_label }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="18" height="18" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    {% endif %}
  </div>

  {% if section.settings.stat_1_value != blank %}
    <div class="hero-stats">
      <div>
        <b>{{ section.settings.stat_1_value }}</b>
        {{ section.settings.stat_1_label }}
      </div>
      <div>
        <b>{{ section.settings.stat_2_value }}</b>
        {{ section.settings.stat_2_label }}
      </div>
      <div>
        <b>{{ section.settings.stat_3_value }}</b>
        {{ section.settings.stat_3_label }}
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image de fond (plein écran)" },
    { "type": "text",  "id": "rating_text",   "label": "Texte note (ex: 4.8/5 · 2 300 avis)", "default": "4.8/5 · 2 300 avis" },
    { "type": "text",  "id": "heading",        "label": "Titre",    "default": "Vos pieds portent tout le poids. Il est temps de les soutenir." },
    { "type": "textarea", "id": "text",        "label": "Texte",    "default": "Des semelles de confort et de posture, glissées dans vos chaussures en dix secondes." },
    { "type": "text",  "id": "button_label",   "label": "Bouton",   "default": "Découvrir les semelles" },
    { "type": "url",   "id": "button_link",    "label": "Lien du bouton" },
    { "type": "text",  "id": "stat_1_value",   "label": "Stat 1 — valeur",  "default": "4.8/5" },
    { "type": "text",  "id": "stat_1_label",   "label": "Stat 1 — libellé", "default": "2 300 avis" },
    { "type": "text",  "id": "stat_2_value",   "label": "Stat 2 — valeur",  "default": "48h" },
    { "type": "text",  "id": "stat_2_label",   "label": "Stat 2 — libellé", "default": "Livraison" },
    { "type": "text",  "id": "stat_3_value",   "label": "Stat 3 — valeur",  "default": "45j" },
    { "type": "text",  "id": "stat_3_label",   "label": "Stat 3 — libellé", "default": "Essai chez vous" }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
