<section class="social-proof">
  <div class="social-proof-head">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.instagram_url != blank %}
      <a href="{{ section.settings.instagram_url }}" class="insta-link" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
        Suivez-nous sur <u>Instagram</u>
      </a>
    {% endif %}
  </div>

  {% if section.settings.image_1 or section.settings.image_2 %}
    <div class="social-grid">
      {% if section.settings.image_1 %}
        <div class="social-grid-img social-grid-img--tall">
          <img
            src="{{ section.settings.image_1 | image_url: width: 800 }}"
            alt="{{ section.settings.image_1_alt | default: '' | escape }}"
            loading="lazy"
            style="height:100%; object-fit:cover;"
          >
        </div>
      {% endif %}
      {% if section.settings.image_2 %}
        <div class="social-grid-img">
          <img
            src="{{ section.settings.image_2 | image_url: width: 600 }}"
            alt="{{ section.settings.image_2_alt | default: '' | escape }}"
            loading="lazy"
          >
        </div>
      {% endif %}
      {% if section.settings.image_3 %}
        <div class="social-grid-img">
          <img
            src="{{ section.settings.image_3 | image_url: width: 600 }}"
            alt="{{ section.settings.image_3_alt | default: '' | escape }}"
            loading="lazy"
          >
        </div>
      {% endif %}
    </div>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="review-cards">
      {% for block in section.blocks %}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="star-badge">
            {% for i in (1..block.settings.rating) %}★{% endfor %}
            &nbsp;{{ block.settings.rating }}/5
          </div>
          <p>{{ block.settings.quote }}</p>
          {% if block.settings.author != blank %}
            <div class="who" style="margin-top:12px; font-size:.8rem; color:var(--ink-soft); font-weight:500;">— {{ block.settings.author }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Preuve sociale",
  "settings": [
    { "type": "text",         "id": "heading",       "label": "Titre",           "default": "Ils l'ont adopté" },
    { "type": "url",          "id": "instagram_url", "label": "Lien Instagram" },
    { "type": "image_picker", "id": "image_1",       "label": "Photo 1 (grande)" },
    { "type": "text",         "id": "image_1_alt",   "label": "Alt photo 1" },
    { "type": "image_picker", "id": "image_2",       "label": "Photo 2" },
    { "type": "text",         "id": "image_2_alt",   "label": "Alt photo 2" },
    { "type": "image_picker", "id": "image_3",       "label": "Photo 3" },
    { "type": "text",         "id": "image_3_alt",   "label": "Alt photo 3" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "range",    "id": "rating", "label": "Note",     "min": 1, "max": 5, "default": 5 },
        { "type": "textarea", "id": "quote",  "label": "Avis" },
        { "type": "text",     "id": "author", "label": "Auteur" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "review", "settings": { "rating": 5, "quote": "Je pensais vraiment que c'était exagéré. Et puis j'ai essayé.", "author": "Marine, 34 ans" } },
      { "type": "review", "settings": { "rating": 5, "quote": "La livraison est hyper rapide et le produit tient toutes ses promesses.", "author": "Lucas, sportif" } }
    ]
  },
  "presets": [ { "name": "Preuve sociale" } ]
}
{% endschema %}
