<section class="testimonials">
  <div class="section-head">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="testimonial-grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="star-badge">
            {% for i in (1..block.settings.rating) %}★{% endfor %}
            &nbsp;{{ block.settings.rating }}/5
          </div>
          <p>{{ block.settings.quote }}</p>
          <div class="who">— {{ block.settings.author }}</div>
        </div>
      {% endfor %}
    {% else %}
      <div class="testimonial-card">
        <div class="star-badge">★★★★★&nbsp;5/5</div>
        <p>Je travaille debout huit heures par jour, mes pieds ne me font plus mal en fin de service. Je les recommande à toutes mes collègues.</p>
        <div class="who">— Nadia, aide-soignante</div>
      </div>
      <div class="testimonial-card">
        <div class="star-badge">★★★★★&nbsp;5/5</div>
        <p>Enfin une semelle qui ne glisse pas dans la chaussure et qui absorbe vraiment les chocs. Parfaite pour mes journées de commercial.</p>
        <div class="who">— Thomas, commercial</div>
      </div>
      <div class="testimonial-card">
        <div class="star-badge">★★★★★&nbsp;5/5</div>
        <p>Installation en deux minutes, découpées à ma pointure sans effort. Je les ai mises dans mes chaussures de bloc opératoire.</p>
        <div class="who">— Julie, infirmière</div>
      </div>
      <div class="testimonial-card">
        <div class="star-badge">★★★★★&nbsp;5/5</div>
        <p>La version chauffante a changé mes trajets à vélo cet hiver. Je les recommande à tous les livreurs.</p>
        <div class="who">— Karim, livreur</div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Témoignages",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ils ont retrouvé leur confort" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Témoignage",
      "settings": [
        { "type": "range",    "id": "rating", "label": "Note",     "min": 1, "max": 5, "default": 5 },
        { "type": "textarea", "id": "quote",  "label": "Citation" },
        { "type": "text",     "id": "author", "label": "Auteur" }
      ]
    }
  ],
  "presets": [ { "name": "Témoignages" } ]
}
{% endschema %}
