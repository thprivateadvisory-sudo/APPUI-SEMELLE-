<!-- Mini-cart drawer -->
<div class="cart-drawer-overlay" id="cart-drawer-overlay"></div>
<aside class="cart-drawer" id="cart-drawer" aria-hidden="true" role="dialog" aria-label="Votre panier">
  <div class="cart-drawer-head">
    <h2 class="cart-drawer-title">Mon panier</h2>
    <button class="icon-btn cart-drawer-close" id="cart-drawer-close" aria-label="Fermer le panier">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="cart-drawer-items" id="cart-drawer-items"></div>
  <div class="cart-drawer-footer">
    <div class="drawer-total-row">
      <span>Sous-total</span>
      <strong id="drawer-total" class="price">—</strong>
    </div>
    <a href="{{ routes.root_url }}checkout" class="btn btn--checkout drawer-checkout-btn" id="drawer-checkout-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="18" height="18" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      Passer commande
    </a>
    <a href="{{ routes.cart_url }}" class="drawer-cart-link">Voir le panier complet</a>
    <div class="drawer-micro-trust">
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="13" height="13" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg>
        45 jours satisfait ou remboursé
      </span>
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="13" height="13" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Paiement sécurisé
      </span>
    </div>
  </div>
</aside>

<header class="main-header">
  <div class="nav">
    <button class="icon-btn" aria-label="Menu" onclick="document.querySelector('.mobile-nav').classList.toggle('open')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name }}">
      <img
        src="{{ 'logo.png' | asset_url }}"
        alt="{{ shop.name }}"
        class="brand__logo"
        width="140"
        height="93"
        loading="eager"
      >
    </a>

    <a href="{{ routes.cart_url }}" class="icon-btn cart-dot" aria-label="Panier" data-cart-count="{{ cart.item_count }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6h2l2.4 12.2a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 2-1.6L22 9H6"/><circle cx="10" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg>
    </a>
  </div>

  <nav class="mobile-nav">
    {% for link in section.settings.menu.links %}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {% endfor %}
  </nav>
</header>

{% schema %}
{
  "name": "En-tête",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu de navigation",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
