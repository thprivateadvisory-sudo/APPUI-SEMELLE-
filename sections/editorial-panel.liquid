<section class="panel-dark">
  <div class="inner">
    <div class="panel-body">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="btn">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>

    <div class="panel-images">
      {% if section.settings.image_1 %}
        <div class="panel-image">
          <img
            src="{{ section.settings.image_1 | image_url: width: 900 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
          >
        </div>
      {% else %}
        <div class="panel-image panel-image--placeholder">
          <svg viewBox="0 0 200 140" xmlns="http://www.w3.org/2000/svg" width="120" opacity=".5">
            <path d="M20 100 C40 60 60 40 100 40 C140 40 160 70 175 100" stroke="#F8F5F0" stroke-width="3" fill="none" stroke-linecap="round"/>
            <circle cx="100" cy="40" r="8" fill="#F8F5F0"/>
          </svg>
        </div>
      {% endif %}

      {% if section.settings.image_2 %}
        <div class="panel-image">
          <img
            src="{{ section.settings.image_2 | image_url: width: 900 }}"
            alt=""
            loading="lazy"
          >
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Panneau éditorial",
  "settings": [
    { "type": "text",     "id": "heading",      "label": "Titre",     "default": "Marcher ne devrait pas faire mal." },
    { "type": "textarea", "id": "text",         "label": "Texte",     "default": "Pas de rendez-vous chez le podologue à attendre trois semaines. Vous commandez en ligne, vous glissez la semelle dans la chaussure, et vous marchez différemment dès le premier jour." },
    { "type": "text",     "id": "button_label", "label": "Bouton",    "default": "Voir la gamme" },
    { "type": "url",      "id": "button_link",  "label": "Lien du bouton" },
    { "type": "image_picker", "id": "image_1",  "label": "Image 1" },
    { "type": "image_picker", "id": "image_2",  "label": "Image 2 (optionnel)" }
  ],
  "presets": [ { "name": "Panneau éditorial" } ]
}
{% endschema %}
