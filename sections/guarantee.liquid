<section class="guarantee-section">
  <div class="guarantee-inner">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div class="guarantee-grid">
      {% for block in section.blocks %}
        <div class="guarantee-card" {{ block.shopify_attributes }}>
          <div class="guarantee-icon">{{ block.settings.icon }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Garanties",
  "settings": [
    { "type": "text",     "id": "heading", "label": "Titre",       "default": "Zéro risque pour vous" },
    { "type": "textarea", "id": "text",    "label": "Sous-titre",  "default": "On est tellement confiants dans nos semelles qu'on vous offre 45 jours pour changer d'avis — sans justification, sans paperasse." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Garantie",
      "settings": [
        { "type": "text",     "id": "icon",  "label": "Icône (emoji)" },
        { "type": "text",     "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text",  "label": "Description" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "icon": "↩", "title": "45 jours satisfait ou remboursé", "text": "Portez-les, testez-les vraiment. Si vous n'êtes pas convaincus : retour gratuit, remboursement complet. Aucune question posée." } },
      { "type": "item", "settings": { "icon": "🚚", "title": "Livraison offerte dès 40€", "text": "Expédié depuis la France en 48h ouvrées. Colis fin, livré directement dans votre boîte aux lettres." } },
      { "type": "item", "settings": { "icon": "🔒", "title": "Paiement 100% sécurisé", "text": "CB, PayPal, Apple Pay — au choix. Vos données bancaires ne transitent jamais sur nos serveurs." } },
      { "type": "item", "settings": { "icon": "🏆", "title": "Qualité validée", "text": "Nos semelles sont recommandées par des kinésithérapeutes et podologues. Elles durent minimum 18 mois d'utilisation quotidienne." } }
    ]
  },
  "presets": [ { "name": "Garanties" } ]
}
{% endschema %}
