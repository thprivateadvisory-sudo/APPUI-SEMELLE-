<section class="notre-histoire">
  <div class="notre-histoire-inner">

    <div class="notre-histoire-label">Notre histoire</div>

    <h2 class="notre-histoire-title">{{ section.settings.heading }}</h2>

    <div class="notre-histoire-body">
      <p>{{ section.settings.paragraph_1 }}</p>
      <p>{{ section.settings.paragraph_2 }}</p>
      <p>{{ section.settings.paragraph_3 }}</p>
    </div>

    <div class="notre-histoire-trust">
      <div class="trust-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="22" height="22" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>Conseillé par certaines pharmacies</span>
      </div>
      <div class="trust-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="22" height="22" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
        <span>Recommandé par des professionnels de santé</span>
      </div>
      <div class="trust-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>Depuis 2007</span>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Notre histoire",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Appui est né d'un constat simple."
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraphe 1",
      "default": "En 2007, face à une offre de semelles bas de gamme et inefficaces sur le marché français, nous avons décidé de changer les choses. Car les pieds, c'est la base de tout. Chaque pas, chaque heure debout, chaque douleur ignorée finit par affecter le dos, les genoux, la posture. L'ensemble du corps."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraphe 2",
      "default": "Nous avons passé des années à développer une semelle qui réponde vraiment aux besoins du quotidien. Pas un produit médical inaccessible, pas un accessoire bon marché qui s'effondre en trois mois. Une semelle juste, efficace, accessible."
    },
    {
      "type": "textarea",
      "id": "paragraph_3",
      "label": "Paragraphe 3",
      "default": "Aujourd'hui, Appui s'implante dans plusieurs pays européens et devient une référence pour ceux qui veulent prendre soin de leurs pieds sans compromis."
    }
  ],
  "presets": [
    { "name": "Notre histoire" }
  ]
}
{% endschema %}
