<section class="products" id="produits">
  <div class="section-head">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p>{{ section.settings.text }}</p>
    {% endif %}
  </div>
  <div class="product-grid">
    {% for block in section.blocks %}
      {% if block.settings.product != blank %}
        {% render 'product-card', product: block.settings.product %}
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Produits en avant",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Deux semelles, une seule promesse" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Une base de confort pour toute l'année, et une version chauffante pour les mois froids." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit",
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" }
      ]
    }
  ],
  "presets": [ { "name": "Produits en avant" } ]
}
{% endschema %}
