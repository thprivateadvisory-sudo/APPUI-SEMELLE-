<section class="features">
  <div class="features-grid">
    {% for block in section.blocks %}
      <div class="feature-card">
        {% if block.settings.icon != blank %}
          <div class="feature-icon">{{ block.settings.icon }}</div>
        {% endif %}
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Grille de fonctionnalités",
  "blocks": [
    {
      "type": "feature",
      "name": "Fonctionnalité",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "feature", "settings": { "title": "Dans toutes vos chaussures", "text": "Une découpe simple aux ciseaux pour s'adapter à n'importe quelle pointure." } },
      { "type": "feature", "settings": { "title": "Toute l'année", "text": "Confort au quotidien en toute saison, avec une gamme chauffante pour l'hiver." } },
      { "type": "feature", "settings": { "title": "Livré en 48h", "text": "Expédié depuis la France, dans un colis fin qui passe partout." } }
    ]
  },
  "presets": [ { "name": "Grille de fonctionnalités" } ]
}
{% endschema %}
