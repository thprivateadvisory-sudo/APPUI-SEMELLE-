<section class="features">
  <div class="features-grid">
    {% for block in section.blocks %}
      <div class="feature-card">
        {% if block.settings.icon != blank %}
          <div class="feature-icon">{{ block.settings.icon }}</div>
        {% endif %}
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Grille de fonctionnalités",
  "blocks": [
    {
      "type": "feature",
      "name": "Fonctionnalité",
      "settings": [
        { "type": "text",     "id": "icon",  "label": "Icône (emoji)" },
        { "type": "text",     "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text",  "label": "Texte" }
      ]
    }
  ],
  "presets": [ { "name": "Grille de fonctionnalités" } ]
}
{% endschema %}
